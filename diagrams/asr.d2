...@_theme
direction: down
audio: "~∿~ speech audio" {class: io}
fe: "Feature\nExtraction" {class: box}
am: "Acoustic Model\n(Jasper · QuartzNet)" {class: core}
lm: "Language Model\n(n-gram)" {class: core}
dec: "Decoder" {class: box}
text: "\"Hello World\"" {class: io}
audio -> fe {class: flow}
fe -> am: "spectrogram" {class: flow}
am -> dec: "Pₜ(c)" {class: flow}
lm -> dec: "word probs" {class: flow}
dec -> text {class: flow}
